# ═══════════════════════════════════════════════════════════════════
# EduZone Student App — single environment template
#
# Copy this file to `.env` and fill in real values. `.env` is the ONLY
# environment file every command uses:
#
#   flutter run  --dart-define-from-file=.env
#   flutter build apk --release --dart-define-from-file=.env
#   flutter build appbundle --release --dart-define-from-file=.env
#
# This is the FLUTTER CLIENT app's env template. It must only ever
# contain the public anon key — never the service-role key. The
# service-role key bypasses RLS entirely; it belongs only in trusted
# backend/Edge Function environments, never in an app that ships to
# end-user devices. If you're looking for backend config (Edge
# Functions, admin dashboard), use that project's own env, not this one.
#
# `.env` itself is git-ignored and must NEVER be committed.
# ═══════════════════════════════════════════════════════════════════

# ── Supabase ────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ── Environment flavor ──────────────────────────────────────────────
# development | production. In release builds APP_ENV=production is
# what gates production-only behavior (Sentry sampling, RASP
# enforcement defaults, ...). Flip APP_ENV and SENTRY_DSN together —
# a production build pointing at the dev Sentry project loses crash
# reports.
APP_ENV=development
SENTRY_DSN=your-sentry-dsn

# ── Next.js video proxy used by the YouTube player. Optional —
# falls back to the current production Vercel deployment if omitted
# (see AppConfig).
PROXY_BASE_URL=https://youtube-proxy-roan.vercel.app

# ── freeRASP / RASP security flags ──────────────────────────────────
# The first three are REQUIRED for release builds: the app fail-fasts
# at startup (StateError, caught and logged) when they are empty in a
# release build — see lib/core/security/freerasp_config.dart.
#
# Base64 SHA-256 hash of the Android release signing certificate:
#   keytool -list -v -keystore <release>.keystore -alias <alias> | grep SHA256
#   echo -n "<HEX_WITHOUT_COLONS>" | xxd -r -p | base64
SECURITY_ANDROID_SIGNING_HASH=

# Apple Developer Team ID (App Store Connect / developer.apple.com).
SECURITY_IOS_TEAM_ID=

# iOS bundle id freeRASP should expect.
SECURITY_IOS_BUNDLE_ID=com.eduzone.learn.app

# Email address Talsec sends threat alerts to. Required for release
# builds — no default is hardcoded in source.
SECURITY_WATCHER_MAIL=

# Set to "true" to actually terminate the app when freeRASP detects a
# threat (root/jailbreak/hooking/tampering/etc). Release builds default
# to enforcement ON when omitted; debug/dev builds default to OFF
# (log-only) so local development on emulators/rooted test devices
# isn't blocked. Set explicitly to "false" only for a deliberate
# telemetry-only rollout — see lib/core/security/README.md.
SECURITY_ENFORCE_THREAT_TERMINATION=
