# Supabase Cloud
# This is the FLUTTER CLIENT app's env file. It must only ever contain the
# public anon key — never the service-role key. The service-role key
# bypasses RLS entirely; it belongs only in trusted backend/Edge Function
# environments, never in an app that ships to end-user devices. If you're
# looking for backend config (Edge Functions, admin dashboard), use that
# project's own .env, not this one.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
APP_ENV=development
SENTRY_DSN=your-sentry-dsn

# Next.js video proxy used by the YouTube player. Optional — falls back to
# the current production Vercel deployment if omitted (see AppConfig).
PROXY_BASE_URL=https://youtube-proxy-roan.vercel.app