# Copy this file to .env.security and fill in real production values.
# .env.security is git-ignored — never commit real secrets.
#
# Usage:
#   flutter build apk --release --dart-define-from-file=.env.security
#   flutter build ipa --release --dart-define-from-file=.env.security
#
# In release builds, SECURITY_ANDROID_SIGNING_HASH and SECURITY_IOS_TEAM_ID
# are required — the app will throw a StateError on startup (caught and
# logged, not fatal to the whole app boot) if they are left empty. See
# lib/core/security/freerasp_config.dart.

# Base64 SHA-256 hash of the Android release signing certificate.
# Get it with:
#   keytool -list -v -keystore <release>.keystore -alias <alias> | grep SHA256
SECURITY_ANDROID_SIGNING_HASH=

# Apple Developer Team ID (found in App Store Connect / developer.apple.com).
SECURITY_IOS_TEAM_ID=

# iOS bundle id freeRASP should expect. Defaults to com.eduzone.learn.app
# if omitted.
SECURITY_IOS_BUNDLE_ID=com.eduzone.learn.app

# Email address Talsec sends threat alerts to. Defaults to
# security@eduzone.com if omitted.
SECURITY_WATCHER_MAIL=security@eduzone.com

# Set to "true" to actually terminate the app when freeRASP detects a
# threat (root/jailbreak/hooking/tampering/etc). Release builds now
# default to enforcement ON even if this is omitted; debug/dev builds
# default to OFF (log-only) so local development on emulators/rooted
# test devices isn't blocked. See lib/core/security/security_service.dart.
# Set explicitly to "false" here only if you intentionally want a
# release build to ship in telemetry-only mode (e.g. an initial rollout
# to confirm the false-positive rate in security_incidents before
# enabling termination) — do not leave this unset and assume it is off.
SECURITY_ENFORCE_THREAT_TERMINATION=true
